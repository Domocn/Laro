# Copy to deploy/.env and fill in. Used by deploy/docker-compose.cheap.yml.

# Public DNS name pointing at this VPS (Caddy gets a TLS cert for it).
# You can use the OVH hostname, e.g. vps-51feb6de.vps.ovh.net, or your own domain.
LARO_DOMAIN=vps-51feb6de.vps.ovh.net

# Database
POSTGRES_USER=laro
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=laro

# Security — generate with: openssl rand -base64 48
JWT_SECRET=change-me-min-32-chars

# AI provider. Cheapest options:
#  - leave as 'ollama' and use the on-device AI in the Android app (no server AI cost)
#  - or set LLM_PROVIDER=openai / anthropic and provide a key (pay-per-use)
LLM_PROVIDER=ollama
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Restrict in production to your frontend origin(s), e.g. https://app.example.com
CORS_ORIGINS=*

# Only needed if THIS server is the "Laro Cloud" relay for self-hosted instances.
# Set to wss://<LARO_DOMAIN>/api/v1/remote/relay after DNS/TLS is up.
# CLOUD_RELAY_URL=wss://vps-51feb6de.vps.ovh.net/api/v1/remote/relay
