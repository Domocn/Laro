# ===========================================
# Laro Backend Configuration
# Copy this file to .env and fill in your values
# ===========================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://laro:your-secure-password@localhost:5432/laro

# Security - CHANGE THIS IN PRODUCTION!
JWT_SECRET=generate-a-secure-random-string-here-min-32-chars

# AI Provider (choose one)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Or use cloud AI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key

# Email (for password reset)
EMAIL_ENABLED=false
# RESEND_API_KEY=re_your-key
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# OAuth (optional)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret
# GITHUB_CLIENT_ID=your-client-id
# GITHUB_CLIENT_SECRET=your-secret
# OAUTH_REDIRECT_BASE_URL=https://yourdomain.com

# Redis (optional - for multi-instance deployments)
# REDIS_URL=redis://localhost:6379

# Billing provider for web Pro: revenuecat (default, use Paddle in RC dashboard) or lemonsqueezy
# LARO_BILLING_PROVIDER=revenuecat
# LARO_RC_WEB_BILLING_ENGINE=paddle

# Lemon Squeezy (optional direct checkout — only if LARO_BILLING_PROVIDER=lemonsqueezy)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID_WEEKLY=
# LEMONSQUEEZY_VARIANT_ID_MONTHLY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_CHECKOUT_REDIRECT_URL=https://laro.food/settings?pro=success
# Webhook URL: https://your-domain/api/v1/subscriptions/webhook/lemonsqueezy

# RevenueCat (legacy Play / optional Web Billing webhooks)
# REVENUECAT_WEBHOOK_AUTH=
